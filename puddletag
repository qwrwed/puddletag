        class _DarkTitles(_QObject):
            def eventFilter(self, obj, ev):
                if ev.type() == _QEvent.Show and getattr(obj, 'isWindow', None) \
                        and obj.isWindow() and not obj.property('_dark_title'):
                    obj.setProperty('_dark_title', True)
                    _dark_title(obj)
                return False

