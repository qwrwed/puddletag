            'Shadow': '#000000', 'BrightText': '#ff6060', 'Link': '#6aa8e8',
            'LinkVisited': '#a88ae8', 'PlaceholderText': '#808080'},
        'disabled': {'WindowText': '#707070', 'Text': '#707070',
                     'ButtonText': '#707070', 'Highlight': '#3a3a3a'},
        'table': {'selection': '#2d4a6a', 'preview': '#285028', 'highlight': '#1e5a1e'},
        'extendedtags': {'add': '#6e6400', 'edit': '#1e5a1e', 'remove': '#781e1e'},
    }
    _theme_path = os.path.join(puddlestuff.constants.CONFIGDIR, 'theme.json')
    if not os.path.exists(_theme_path):
        os.makedirs(os.path.dirname(_theme_path), exist_ok=True)
        with open(_theme_path, 'w', encoding='utf-8') as _fh:
            _json.dump(_theme_default, _fh, indent=2)

    def _apply_theme():
        try:
            with open(_theme_path, encoding='utf-8') as fh:
                theme = _json.load(fh)
        except (OSError, ValueError) as e:
            print('theme.json not applied:', e)
            return
        pal = QPalette()
        for role, colour in theme.get('palette', {}).items():
            pal.setColor(getattr(QPalette, role), QColor(colour))
        for role, colour in theme.get('disabled', {}).items():
            pal.setColor(QPalette.Disabled, getattr(QPalette, role), QColor(colour))
        app.setPalette(pal)
        table = theme.get('table', {})
        tagmodel = sys.modules.get('puddlestuff.tagmodel')
        if tagmodel is not None and 'highlight' in table:
            tagmodel.HIGHLIGHTCOLOR = QColor(table['highlight'])
        for w in app.allWidgets():
            m = w.model() if hasattr(w, 'model') and callable(w.model) else None
            if m is not None and hasattr(m, 'previewBackground'):
                if 'selection' in table:
                    m.selectionBackground = QColor(table['selection'])
                if 'preview' in table:
                    m.previewBackground = QColor(table['preview'])
                if 'highlight' in table:
                    old = m.permaColor
                    m.permaColor = QColor(table['highlight'])
                    for t in m.taginfo:
                        if getattr(t, 'color', None) is not None and QColor(t.color) == QColor(old):
                            t.color = m.permaColor
                w.viewport().update()
            if type(w).__name__ == 'ExTags' and hasattr(w, 'loadSettings'):
                w.loadSettings()
        if _theme_path not in _theme_watcher.files():
            _theme_watcher.addPath(_theme_path)
        info = ['Base=%s' % pal.color(QPalette.Base).name()]
        if tagmodel is not None:
            info.append('HIGHLIGHTCOLOR=%s' % QColor(tagmodel.HIGHLIGHTCOLOR).name())
        for w in app.allWidgets():
            if hasattr(w, 'permaColor') is False and hasattr(w, 'model') and callable(w.model) \
                    and hasattr(w.model(), 'permaColor'):
                info.append('permaColor=%s' % w.model().permaColor.name())
                break
        for w in app.allWidgets():
            if type(w).__name__ == 'ExTags':
                info.append('ExTags.add=%s' % w._colors[1].color().name())
        print('theme applied: ' + ' '.join(info), flush=True)

    _theme_watcher = _Watcher()
    _theme_watcher.fileChanged.connect(lambda _p: _QTimer.singleShot(150, _apply_theme))
